[user]
{{ if eq .profile "work" }}
    email = work@company.com
    name = Your Work Name
{{ else }}
	email = isidor.karlsson@pm.me
	name = Isidor
{{ end }}

[core]
    editor = "$VISUAL"
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[color]
    ui = auto

[alias]
    st = status
    co = checkout
    br = branch
    lg = log --oneline --graph --decorate