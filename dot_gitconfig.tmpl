[user]
    email = {{ .git.email | quote }}
    name = {{ .git.name | quote }}
{{ if eq .profile "work" }}
    email = work@company.com
    name = Your Work Name
{{ else }}
	email = private@email.com
	name = Isidor
{{ end }}

[core]
    editor = "$VISUAL"
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    autoSetupRemote = true

[color]
    ui = auto

[alias]
    st = status
    co = checkout
    br = branch
    lg = log --oneline --graph --decorate